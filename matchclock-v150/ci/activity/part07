    private fun buildLogScreen(): View {
        val page = col()
        page.addView(header("السجل", "جميع أحداث المباريات"), LinearLayout.LayoutParams(-1, dp(if (isTablet) 76 else 68)))
        val tabs = row().apply { setPadding(dp(12), dp(10), dp(12), dp(8)) }
        listOf("all" to "الكل", "goal" to "الأهداف", "cards" to "البطاقات").forEach { (k, label) ->
            val selected = logFilter == k
            tabs.addView(button(label, if (selected) green else surface(), if (selected) Color.WHITE else ink(), 40, 99) {
                logFilter = k
                renderScreen()
            }, LinearLayout.LayoutParams(0, dp(40), 1f).apply { marginStart = dp(4); marginEnd = dp(4) })
        }
        page.addView(tabs)

        val all = mutableListOf<Pair<MatchState, MatchEvent>>()
        states.forEach { s ->
            s.events.forEach { e ->
                val ok = when (logFilter) {
                    "goal" -> e.kind == "goal"
                    "cards" -> e.kind == "yellow" || e.kind == "red"
                    else -> true
                }
                if (ok) all.add(s to e)
            }
        }
        all.sortByDescending { it.second.timeMs }

        val scroll = ScrollView(this)
        val box = col().apply { setPadding(dp(12), 0, dp(12), dp(12)) }
        if (all.isEmpty()) {
            box.addView(txt("لا توجد أحداث مسجلة.", 14f, muted(), false, Gravity.CENTER).apply { setPadding(0, dp(40), 0, dp(40)) })
        } else all.forEach { (s, e) ->
            val card = col().apply {
                background = shape(surface(), 13, line())
                setPadding(dp(10), dp(8), dp(10), dp(8))
                addView(txt(s.title, 11f, muted(), true))
                addView(eventRow(s, e))
                setOnClickListener { selectedId = s.id; currentScreen = "match"; buildShell() }
            }
            box.addView(card, LinearLayout.LayoutParams(-1, -2).apply { bottomMargin = dp(8) })
        }
        scroll.addView(box)
        page.addView(scroll, LinearLayout.LayoutParams(-1, 0, 1f))
        return page
    }

    private fun buildTournamentsScreen(): View {
        val page = col()
        page.addView(header("البطولات", "نظرة سريعة على مبارياتك"), LinearLayout.LayoutParams(-1, dp(if (isTablet) 76 else 68)))
        val scroll = ScrollView(this)
        val box = col().apply { setPadding(dp(12), dp(12), dp(12), dp(12)) }

        val statRow = row()
        statRow.addView(statCard("المباريات", states.size.toString(), green), LinearLayout.LayoutParams(0, dp(92), 1f).apply { marginEnd = dp(4) })
        statRow.addView(statCard("المباشرة", states.count { it.running }.toString(), red), LinearLayout.LayoutParams(0, dp(92), 1f).apply { marginStart = dp(4); marginEnd = dp(4) })
        statRow.addView(statCard("المنتهية", states.count { it.archived }.toString(), blue), LinearLayout.LayoutParams(0, dp(92), 1f).apply { marginStart = dp(4) })
        box.addView(statRow)

        val groups = states.groupBy { it.title.ifBlank { "مباريات بدون بطولة" } }
        box.addView(txt("البطولات والمجموعات", 16f, ink(), true).apply { setPadding(dp(4), dp(18), 0, dp(8)) })
        if (groups.isEmpty()) {
            box.addView(txt("أضف مباريات لتظهر البطولات هنا.", 13f, muted(), false, Gravity.CENTER).apply { setPadding(0, dp(30), 0, dp(30)) })
        } else groups.forEach { (name, matches) ->
            val card = row().apply {
                background = shape(surface(), 14, line())
                setPadding(dp(12), dp(12), dp(12), dp(12))
                addView(txt("🏆", 27f, amber, true, Gravity.CENTER), LinearLayout.LayoutParams(dp(46), dp(50)))
                val texts = col().apply {
                    addView(txt(name, 14f, ink(), true))
                    addView(txt("${matches.size} مباراة • ${matches.count { it.archived }} منتهية", 11f, muted()))
                }
                addView(texts, LinearLayout.LayoutParams(0, -2, 1f))
            }
            box.addView(card, LinearLayout.LayoutParams(-1, -2).apply { bottomMargin = dp(8) })
        }
        scroll.addView(box)
        page.addView(scroll, LinearLayout.LayoutParams(-1, 0, 1f))
        return page
    }

    private fun statCard(label: String, value: String, color: Int): View = col().apply {
        gravity = Gravity.CENTER
        background = shape(surface(), 14, line())
        addView(txt(value, 28f, color, true, Gravity.CENTER))
        addView(txt(label, 11f, muted(), true, Gravity.CENTER))
    }

