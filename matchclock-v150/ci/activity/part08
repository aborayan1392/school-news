    private fun updateLiveViews() {
        val id = currentDashboardId
        if (id <= 0L) return
        val s = states.firstOrNull { it.id == id } ?: return
        if (s.running && s.autoPause && !prefs.getBoolean("secondHalf:${s.id}", false)) {
            val firstCap = s.halfMinutes * 60_000L
            if (s.currentElapsed() >= firstCap) {
                s.freeze()
                save()
            }
        }
        liveTimer?.text = clock(s.currentElapsed())
        liveAdded?.text = "+${clockAdded(s.currentLost())} الوقت بدل الضائع"
        liveScore?.text = "${s.scoreHome} - ${s.scoreAway}"
        liveStatus?.text = if (s.running) "مباشر" else if (s.archived) "منتهية" else "متوقف"
    }

    private fun periodLabel(s: MatchState): String {
        val cap = s.halfMinutes * 60_000L
        return if (s.currentElapsed() >= cap) "الشوط الثاني" else "الشوط الأول"
    }

    private fun eventName(kind: String) = when (kind) {
        "goal" -> "هدف ⚽"
        "yellow" -> "إنذار ▣"
        "red" -> "طرد ■"
        "extra" -> "وقت ضائع ◴"
        else -> kind
    }

    private fun eventColor(kind: String) = when (kind) {
        "goal" -> green
        "yellow" -> amber
        "red" -> red
        "extra" -> blue
        else -> ink()
    }

    private fun teamName(s: MatchState, team: String) = if (team == "home") s.home else s.away

    private fun teamColors(s: MatchState): Pair<Int, Int> =
        prefs.getInt("homeColor:${s.id}", green) to prefs.getInt("awayColor:${s.id}", blue)

    private fun nextColor(current: Int): Int {
        val i = palette.indexOf(current)
        return palette[(if (i < 0) 0 else i + 1) % palette.size]
    }

    private fun findSelected(): MatchState? =
        states.firstOrNull { it.id == selectedId } ?: states.firstOrNull()

