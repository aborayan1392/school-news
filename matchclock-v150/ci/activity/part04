       background = shape(color, 13)
        setPadding(dp(3), dp(7), dp(3), dp(7))
        addView(txt(icon, 23f, Color.WHITE, true, Gravity.CENTER), LinearLayout.LayoutParams(-1, 0, 1f))
        addView(txt(label, 11.5f, Color.WHITE, true, Gravity.CENTER), LinearLayout.LayoutParams(-1, 0, 0.7f))
